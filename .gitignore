# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Keil MDK-ARM (firmware/) ----
# Build output
firmware/**/Objects/
firmware/**/Listings/
firmware/**/*.o
firmware/**/*.d
firmware/**/*.axf
firmware/**/*.hex
firmware/**/*.bin
firmware/**/*.map
firmware/**/*.htm
firmware/**/*.lnp
firmware/**/*.dep
firmware/**/*.crf
firmware/**/*.iex

# Keil per-user / local state (not part of the shareable project)
firmware/**/*.uvguix.*
firmware/**/*.uvoptx
firmware/**/*.bak
firmware/**/DebugConfig/
firmware/**/RTE/_Target_1/
# Keil Pack Manager baseline copies (auto-regenerated on pack update, never edited by hand)
firmware/**/*.base@*
firmware/**/JLinkLog.txt
firmware/**/EWA*.log
firmware/**/EventRecorderStub.scvd

# Keep: *.uvprojx (the actual project file) and source under Core/, Drivers/

# ---- Reference code kept locally only (never published) ----
# Course/teacher drivers (ARM University Program, ST Standard Peripheral Library,
# teacher-written I2C) used only as reading material while writing our own
# drivers. Not part of the Keil project; not ours to redistribute.
firmware/**/reference/
firmware/manual/

# ---- Editor cruft ----
.vscode/
*.swp

# ---- linux-gateway/ ----
# Yocto build directories are tens of GB and must never be committed. The real build
# lives outside the repo (~/yocto/build in WSL); these rules are a safety net in case a
# build directory is ever created inside it. Only linux-gateway/conf/ and, later, my own
# layer are tracked.
linux-gateway/**/build/
linux-gateway/**/sstate-cache/
linux-gateway/**/downloads/
linux-gateway/**/tmp/

# The Wi-Fi key of the gateway image lives in ~/yocto/secrets/ (outside the repo, see
# ADR-0015). This is a safety net in case such a folder is ever created inside the repo.
**/secrets/